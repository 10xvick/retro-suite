{
  "name": "shell-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check-architecture": "node tools/check-architecture.mjs",
    "verify-architecture": "npm run check-architecture && tsc -p tsconfig.app.json --noEmit",
    "build": "npm run check-architecture && tsc -b && vite build",
    "preview": "vite preview",
    "check-chrome": "npx tsx disasm_rom.js",
    "test-emulator": "node test_emulator.js",
    "test": "node run_browser_test.js",
    "test:video-monitor": "npx tsx run_video_monitor.ts"
  },
  "dependencies": {
    "lucide-react": "^0.475.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "snes-core": "*",
    "nes-core": "*",
    "gb-core": "*",
    "gba-core": "*",
    "atari-core": "*"
  },
  "devDependencies": {
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "puppeteer": "^25.1.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.12"
  }
}